{
  "name": "streammask-desktop",
  "productName": "StreamMask Desktop",
  "version": "0.2.0",
  "description": "Open-source stream privacy tool: hides chosen apps and notifications while you're live, and gives you a browser window that screen capture can't see.",
  "main": "src/main.js",
  "license": "MIT",
  "author": "KursadEren",
  "repository": "https://github.com/KursadEren/streammask-desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --publish never",
    "test": "npm run test:bridge && npm run test:titles && npm run test:platform && npm run test:browser",
    "sync-engine": "node scripts/sync-engine.js",
    "test:bridge": "node test/bridge.test.js",
    "test:browser": "electron test/private-browser.test.js",
    "test:titles": "node test/title-rules.test.js",
    "test:platform": "node test/platform.test.js",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:all": "npm run dist && npm run dist:win"
  },
  "build": {
    "appId": "io.github.kursaderen.streammask",
    "productName": "StreamMask Desktop",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  }
}
